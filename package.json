{
  "name": "microcode-inspector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "node --experimental-strip-types tests/device/connection-framework.test.ts",
    "test": "node --experimental-strip-types --test tests/device/connection-framework.test.ts tests/device/esp32-adapter.test.ts tests/device/uno-adapter.test.ts tests/extraction/esp32-flash-extractor.test.ts tests/safety/readonly-assertions.test.ts tests/unit/address.test.ts tests/unit/crypto.test.ts",
    "test:python": "python -m unittest discover -s agent/tests -p \"test_*.py\"",
    "test:all": "npm test && npm run test:python",
    "preview": "vite preview"
  },
  "dependencies": {
    "esptool-js": "0.7.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}

