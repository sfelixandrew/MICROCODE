# MICROCODE INSPECTOR Environment Configuration Example
# No secrets or credentials should ever be placed in this file.
# Firmware processing is 100% local; zero external telemetry or cloud endpoints.

# Local AVR companion port (defaults to 8765 on loopback 127.0.0.1)
VITE_COMPANION_API_URL=http://127.0.0.1:8765

# Development server port (defaults to 5173)
VITE_DEV_PORT=5173

